POSTGRES_DB=lodge_crm
POSTGRES_USER=lodge
POSTGRES_PASSWORD=change-this-long-random-admin-password
DATABASE_ADMIN_URL=postgresql+psycopg://lodge:change-this-long-random-admin-password@postgres:5432/lodge_crm
APP_DATABASE_ROLE=lodge_app
APP_DATABASE_PASSWORD=change-this-separate-app-password
APP_DATABASE_URL=postgresql+psycopg://lodge_app:change-this-separate-app-password@postgres:5432/lodge_crm
REDIS_URL=redis://redis:6379/0
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=lodgecrm
OBJECT_STORAGE_SECRET_KEY=change-this-object-storage-secret
OBJECT_STORAGE_BUCKET=lodge-crm-media
OBJECT_STORAGE_REGION=us-east-1

PUBLIC_WEB_URL=http://localhost:3000
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com
# Use an App Password; never use your regular Gmail password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional dedicated Fernet key; falls back to the existing MFA key when blank.
# Preserve existing encryption keys when updating an installation.
EMAIL_ENCRYPTION_KEY=
INVITATION_TTL_HOURS=72
INVITATION_RESEND_COOLDOWN_SECONDS=60
NOTIFICATION_ESCALATION_MINUTES=60

# Required to enable MFA. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
PASSWORD_RESET_TTL_MINUTES=30

# Optional external vLLM. Core CRM never requires a GPU. See docs/AI_SETUP.md.
AI_ENABLED=false
AI_PROVIDER=vllm
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=
AI_REQUEST_TIMEOUT=30
AI_MAX_CONTEXT=16384
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_ROUNDS=4
AI_USER_REQUESTS_PER_MINUTE=6
AI_LODGE_REQUESTS_PER_MINUTE=30
AI_LODGE_CONCURRENCY=2
